{
  "description": "NovaDDE: the per-session brief, the per-message reminder, job attribution, and the optional submission deny.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-brief.sh",
            "args": [],
            "timeout": 20,
            "statusMessage": "Reading the Model Platform"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/user-suffix.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*model_platform__(submit_job|submit_pipeline_run)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/submit-guard.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*model_platform__(submit_job|submit_pipeline_run)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/record-job.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
